# Local aggregator environment
# Copy this file to .env for local development.

PORT=3002
NODE_ENV=development
ENVIRONMENT=local
LOG_FORMAT=pino-pretty
BACKEND_BASE_URL=http://localhost:3001

# Optional in local development. In non-local environments set via CDP Secrets.
AGGREGATOR_HEARTBEAT_AUTH_TOKEN=

# Enable scheduler heartbeat when needed
AGGREGATOR_JOB_ENABLED=false
AGGREGATOR_JOB_INTERVAL_MS=3600000

# Defra OGC source (live sample fetch)
DEFRA_OGC_BASE_URL=https://environment.data.gov.uk/geoservices/datasets/394cde56-5cf9-42bf-8d20-86c182f9ce68/ogc/features/v1
DEFRA_OGC_TIMEOUT_MS=8000
DEFRA_OGC_COLLECTION_ID=

# If true, returns local fallback stubs when Defra is unavailable
DATA_STUB_FALLBACK_ENABLED=true
